# Maintainer: u8sand <u8sand@gmail.com>
# Contributor: Alfredo Ramos <alfredo dot ramos at yandex dot com>

_pkgname=baka-mplayer
pkgname=${_pkgname}-git
pkgver=2.0.4
pkgrel=1
pkgdesc='A free and open source, cross-platform, libmpv based multimedia player. Qt6 build. Development version.'
arch=('x86_64' 'aarch64')
url='https://github.com/u8sand/Baka-MPlayer'
license=('GPL')

depends=('mpv' 'qt6-base' 'qt6-svg' 'libx11')
optdepends=(
	'mpv-git: for bleeding-edge mpv features'
	'qt6-translations: for Qt dialog translations'
	'yt-dlp: for remote video streaming'
	'noto-fonts: for proper font support'
)
makedepends=('git' 'cmake' 'qt6-tools')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")

source=(
	"${_pkgname}::git+https://github.com/u8sand/Baka-MPlayer.git"
)
sha512sums=(
	"SKIP"
)

pkgver() {
	# Updating package version
	cd ${srcdir}/${_pkgname}
	(
		set -o pipefail
		git describe --long --tags | sed -r 's/^v//;s/([^-]*-g)/r\1/;s/-/./g' ||
		printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
	)
}

build() {
	cmake -B build -S ${_pkgname} \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR=${pkgdir} cmake --install build
}
