# Maintainer: u8sand <u8sand@gmail.com>
# Contributor: Alfredo Ramos <alfredo dot ramos at yandex dot com>

pkgname=baka-mplayer
pkgver=2.1.0
pkgrel=1
pkgdesc='A free and open source, cross-platform, libmpv based multimedia player. Qt6 build.'
arch=('x86_64' 'aarch64')
url='https://github.com/u8sand/Baka-MPlayer'
license=('GPL')

depends=('mpv' 'qt6-base' 'qt6-svg' 'libx11')
optdepends=(
	'mpv-git: for bleeding-edge mpv features'
	'qt6-translations: for Qt dialog translations'
	'yt-dlp: for remote video streaming'
	'noto-fonts: for proper font support'
)
makedepends=('cmake' 'qt6-tools')
provides=("${pkgname}=${pkgver}")
conflicts=("${pkgname}-git")
replaces=("${pkgname}-git")

source=(
	"${pkgname}-${pkgver}.tar.gz::https://github.com/u8sand/Baka-MPlayer/archive/v${pkgver}.tar.gz"
)

# fill in with `updpkgsums` once the v${pkgver} tag is published
sha512sums=('SKIP')

build() {
	cmake -B build -S Baka-MPlayer-${pkgver} \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR=${pkgdir} cmake --install build
}
